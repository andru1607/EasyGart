{
  "name": "EasyGart Cloud",
  "short_name": "EasyGart",
  "description": "Gestione interventi, squadra e manutenzione del verde",
  "id": "/cloud/",
  "start_url": "/cloud/",
  "scope": "/cloud/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#f5f8f3",
  "theme_color": "#183d30",
  "orientation": "any",
  "lang": "it",
  "icons": [
    {
      "src": "/cloud/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/cloud/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/cloud/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
